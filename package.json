{
    "name": "@tjfeng741963/gamma-ui",
    "version": "0.1.0",
    "description": "布鲁伽马 BlueGamma 设计系统：面向设计与艺术类教育产品的 React 组件库",
    "license": "UNLICENSED",
    "private": false,
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tokens.css": "./dist/styles/tokens.css",
        "./effects.css": "./dist/styles/effects.css",
        "./core/*": {
            "types": "./dist/core/*.d.ts",
            "import": "./dist/core/*.js"
        },
        "./*": {
            "types": "./dist/components/*.d.ts",
            "import": "./dist/components/*.js"
        },
        "./package.json": "./package.json"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "restricted"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tjfeng741963/gamma-ui.git"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src tests",
        "format": "prettier --write \"{src,tests}/**/*.{ts,tsx,css}\"",
        "format:check": "prettier --check \"{src,tests}/**/*.{ts,tsx,css}\"",
        "test": "vitest run",
        "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && node scripts/check-dist.mjs"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.6.0"
    },
    "peerDependencies": {
        "lucide-react": "^1.28.0",
        "motion": "^12.43.0",
        "radix-ui": "^1.6.7",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.0",
        "@types/node": "^22.10.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "eslint": "^9.39.5",
        "eslint-plugin-react-hooks": "^7.0.0",
        "lucide-react": "^1.28.0",
        "motion": "^12.43.0",
        "prettier": "^3.9.6",
        "radix-ui": "^1.6.7",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tailwindcss": "^4.1.0",
        "tsup": "^8.5.0",
        "typescript": "^5.9.0",
        "typescript-eslint": "^8.46.0",
        "vitest": "^4.1.11"
    },
    "packageManager": "pnpm@10.33.0",
    "engines": {
        "node": ">=20"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild"
        ]
    }
}
